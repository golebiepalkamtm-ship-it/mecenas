# LexMind AI - Environment Configuration Example
# Copy this file to .env and fill in your values
# ================================================

# --- REQUIRED ---

# OpenRouter API Key (https://openrouter.ai/keys)
# This is required for all deployments
OPENROUTER_API_KEY=sk-or-your-key-here

# --- OPTIONAL: Cloud Database (Supabase) ---
# Leave empty to run in local-only mode (SQLite)

# Supabase URL (https://xxx.supabase.co)
SUPABASE_URL=

# Supabase Anon Key (public, safe to commit)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (private, NEVER commit to git!)
# Only use for local development or CI/CD with secret manager
SUPABASE_SERVICE_ROLE_KEY=

# --- OPTIONAL: Integrations ---

# Google API Key (for Gemini models)
GOOGLE_API_KEY=

# Cohere API Key (only if using Cohere for reranking)
COHERE_API_KEY=

# --- OPTIONAL: Feature Flags & Configuration (LEXMIND_*) ---

# List of default models (JSON array)
# LEXMIND_DEFAULT_MODELS=["google/gemini-2.5-flash", "openai/gpt-4o-mini"]

# Enable Advanced Legal Investigation (v2 with reasoning)
# LEXMIND_FEATURE_INVESTIGATION_V2=false

# Auto-trigger investigation for long cases
# LEXMIND_FEATURE_INVESTIGATION_V2_AUTO=true

# Reranking provider: 'heuristic' or 'cohere'
# LEXMIND_RERANK_PROVIDER=heuristic

# Enable context compression for long documents
# LEXMIND_FEATURE_CONTEXT_PACKER=true

# Maximum document context characters
# LEXMIND_DOCUMENT_CONTEXT_CHARS=200000

# LLM timeout settings (seconds)
# LEXMIND_LLM_TIMEOUT_PRIMARY=60.0
# LEXMIND_LLM_TIMEOUT_FALLBACK=90.0

# Enable pipeline timing logs (for debugging/observability)
# LEXMIND_FEATURE_PIPELINE_TIMING=true

# --- OPTIONAL: Development Configuration ---

# Enable PyTest debug mode
# PYTEST_DEBUG=false

# Enable PaddleOCR (for OCR profile)
# PADDLEOCR_ENABLED=true

# --- FRONTEND VARIABLES ---
# These are used by Vite and loaded into VITE_* namespace
# Copy to frontend/.env if needed

# API Backend URL
# VITE_API_URL=http://127.0.0.1:8003

# Supabase configuration for frontend auth
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ================================================
# SETUP INSTRUCTIONS
# ================================================
#
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Install backend: pip install -r requirements-core.txt
# 4. Start backend: python api.py
# 5. Frontend: cd frontend && npm install && npm run dev
#
# For more details, see: docs/ENVIRONMENT_CONFIGURATION.md
